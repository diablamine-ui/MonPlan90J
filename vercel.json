{
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 7 * * *"
    }
  ],
  "functions": {
    "api/generate.js": { "maxDuration": 30 },
    "api/subscribe.js": { "maxDuration": 10 },
    "api/cron.js":      { "maxDuration": 60 }
  }
}
